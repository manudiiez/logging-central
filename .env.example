# Copiar a .env para el stack local: cp .env.example .env
# En el VPS estas variables se cargan en Dokploy, no en un archivo del repo.

# Agrupa los servicios de un mismo producto. Va como label `service_namespace`.
SERVICE_NAMESPACE=nazar

# production | testing | development. Va como label `environment`.
ENVIRONMENT=development

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-esto
GRAFANA_ROOT_URL=http://localhost:3000

# Solo para docker-compose.production.yml: el tag de las tres imágenes.
# STACK_VERSION=v1.0.0
LOKI_PORT=3100
