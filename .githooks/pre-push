#!/usr/bin/env bash
# flujo-github: bloquea pushes directos a ramas protegidas y el borrado de tags de versión.
# Es una red de seguridad local; la protección real son los rulesets del repo.
set -euo pipefail

protected_re='^refs/heads/(main|testing|develop)$'
zero='0000000000000000000000000000000000000000'
status=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue

  if [[ "$remote_ref" =~ $protected_re ]]; then
    branch="${remote_ref#refs/heads/}"
    echo "✖ Push directo a '$branch' bloqueado. En este repo se entra a $branch solo por Pull Request." >&2
    echo "  Creá una rama de trabajo (git switch -c fix/N-descripcion) y abrí un PR." >&2
    status=1
  fi

  if [[ "$remote_ref" =~ ^refs/tags/v ]] && [[ "$local_sha" == "$zero" ]]; then
    echo "✖ Borrar el tag de versión '${remote_ref#refs/tags/}' está bloqueado." >&2
    status=1
  fi
done

exit $status
