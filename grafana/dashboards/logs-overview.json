{
  "uid": "logs-overview",
  "title": "Logs — vista general",
  "description": "Punto de entrada al colector: volumen por servicio, errores y el stream filtrable. Provisionado desde el repo; no editar desde la UI.",
  "tags": ["logging-central"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service_namespace", "type": 1 },
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "environment", "type": 1 },
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service_name", "type": 1 },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "level",
        "label": "Nivel",
        "type": "custom",
        "query": "debug,info,warn,error,fatal",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "search",
        "label": "Buscar en la línea",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Líneas en el rango",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_namespace=\"$namespace\", environment=\"$environment\", service_name=~\"$service\"} [$__range]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errores en el rango",
      "description": "level error o fatal. Se filtra por structured metadata, no por label.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_namespace=\"$namespace\", environment=\"$environment\", service_name=~\"$service\"} | level=~\"error|fatal\" [$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top eventos con error",
      "description": "Agrupado por event.name y error.type, que son los dos campos de baja cardinalidad pensados para esto.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ],
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(10, sum by (service_name, event_name, error_type) (count_over_time({service_namespace=\"$namespace\", environment=\"$environment\", service_name=~\"$service\"} | level=~\"error|fatal\" [$__range])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Volumen por servicio",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" }, "lineWidth": 0 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service_name}}",
          "expr": "sum by (service_name) (count_over_time({service_namespace=\"$namespace\", environment=\"$environment\", service_name=~\"$service\"} [$__auto]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errores por servicio",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service_name}}",
          "expr": "sum by (service_name) (count_over_time({service_namespace=\"$namespace\", environment=\"$environment\", service_name=~\"$service\"} | level=~\"error|fatal\" [$__auto]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Stream",
      "description": "Para seguir un request de punta a punta: pegá su request.id en Buscar en la línea.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 16 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"$namespace\", environment=\"$environment\", service_name=~\"$service\"} | level=~\"$level\" |= \"$search\""
        }
      ]
    }
  ]
}
